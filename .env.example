# Cliente (Vite) — claves públicas, seguras para exponer en el navegador
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Servidor (Cloudflare Workers) — mismas claves, disponibles en process.env durante SSR
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Servidor únicamente — clave con privilegios de administrador (bypassa RLS).
# NUNCA exponer con prefijo VITE_. Solo se usa en client.server.ts.
SUPABASE_SERVICE_ROLE_KEY=
